class Solution {
    public int[] productExceptSelf(int[] nums) {

        int total = 1;
        int zeroCount = 0;

        for (int num : nums) {
            if (num == 0) {
                zeroCount++;
            } else {
                total *= num;
            }
        }

        int[] answer = new int[nums.length];

        for (int i = 0; i < nums.length; i++) {

            if (zeroCount > 1) {
                answer[i] = 0;
            }

            else if (zeroCount == 1) {

                if (nums[i] == 0) {
                    answer[i] = total;
                } else {
                    answer[i] = 0;
                }
            }

            else {
                answer[i] = total / nums[i];
            }
        }

        return answer;
    }
}


